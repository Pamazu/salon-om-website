{
  "hosting": {
    "site": "salon-om-option-2",
    "public": ".",
    "cleanUrls": true,
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "*.src.html", "salon-om-option-2.html"],
    "headers": [
      { "source": "**/*.@(mp4|mp3|webp|jpg|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.@(woff2|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] }
    ]
  }
}
